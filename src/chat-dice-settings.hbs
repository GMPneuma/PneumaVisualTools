<form autocomplete="off">
  <div class="form-group"><label>Active dice set (this client)</label><div class="form-fields"><select name="selectedSet">{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div></div>
  <p class="notes">The master switch “Replace chat dice” is in Visual Tools settings. Missing custom images fall back to Pneuma artwork.</p>
  {{#if legacyActive}}<p class="notes">Disable the separate Pneuma Chat Dice module: Visual Tools now owns this replacement.</p>{{/if}}
  {{#if isGM}}
  <hr><h3>Add a shared set</h3>
  <div class="form-group"><label>Name</label><div class="form-fields"><input name="setName" type="text" placeholder="My dice set"></div></div>
  <div class="form-group"><label>Image folder</label><div class="form-fields"><input name="folder" type="text" placeholder="worlds/my-world/dice/my-set"><button type="button" data-browse title="Choose folder"><i class="fas fa-folder-open"></i></button></div></div>
  <div class="form-group"><label>File format</label><div class="form-fields"><select name="extension"><option value="webp">WebP</option><option value="png">PNG</option><option value="svg">SVG</option></select></div></div>
  <p class="notes">Use square, transparent images. Recommended: 256×256 with consistent 16px padding. Put all files directly in the chosen folder, with the same format.</p>
  <p class="notes"><a href="modules/pneuma-visualtools/chat-dice-template.zip" download>Download template set</a></p>
  <details><summary>Required filenames (31 images)</summary><p class="notes">Add the chosen extension to each name:</p><p class="notes">{{files}}</p></details>
  <div class="form-group"><button type="button" data-validate>Validate folder</button><button type="button" data-add>Add and select</button></div>
  <p class="notes" data-status role="status" aria-live="polite"></p>
  {{#each sets}}<div class="form-group"><label>{{name}}</label><div class="form-fields"><button type="button" data-remove="{{id}}">Remove set</button></div></div>{{/each}}
  {{/if}}
  <footer class="sheet-footer flexrow"><button type="submit"><i class="fas fa-check"></i>Apply selection</button></footer>
</form>
